{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "aggregator-route": {
        "ClusterId": "aggregator-cluster",
        "Order": 1,
        "Match": {
          "Path": "/api/deliveries/{**catch-all}"
        }
      },
      "shipping-domain-route": {
        "ClusterId": "shipping-cluster",
        "Order": 10,
        "Match": {
          "Path": "/api/shipping/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/shipping" },
          { "PathPrefix": "/api" }
        ]
      },
      "shipping-direct-shipments-route": {
        "ClusterId": "shipping-cluster",
        "Order": 11,
        "Match": {
          "Path": "/api/shipments/{**catch-all}"
        }
      },
      "shipping-direct-customers-route": {
        "ClusterId": "shipping-cluster",
        "Order": 12,
        "Match": {
          "Path": "/api/customers/{**catch-all}"
        }
      },
      "fleet-domain-route": {
        "ClusterId": "fleet-cluster",
        "Order": 20,
        "Match": {
          "Path": "/api/fleet/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/fleet" },
          { "PathPrefix": "/api" }
        ]
      },
      "fleet-direct-couriers-route": {
        "ClusterId": "fleet-cluster",
        "Order": 21,
        "Match": {
          "Path": "/api/couriers/{**catch-all}"
        }
      },
      "fleet-direct-routes-route": {
        "ClusterId": "fleet-cluster",
        "Order": 22,
        "Match": {
          "Path": "/api/routes/{**catch-all}"
        }
      },
      "fleet-direct-vehicles-route": {
        "ClusterId": "fleet-cluster",
        "Order": 23,
        "Match": {
          "Path": "/api/vehicles/{**catch-all}"
        }
      },
      "fleet-direct-warehouses-route": {
        "ClusterId": "fleet-cluster",
        "Order": 24,
        "Match": {
          "Path": "/api/warehouses/{**catch-all}"
        }
      },
      "fleet-direct-zones-route": {
        "ClusterId": "fleet-cluster",
        "Order": 25,
        "Match": {
          "Path": "/api/zones/{**catch-all}"
        }
      },
      "reviews-domain-route": {
        "ClusterId": "reviews-cluster",
        "Order": 30,
        "Match": {
          "Path": "/api/reviews/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "aggregator-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://aggregator"
          }
        }
      },
      "shipping-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://shipping-api"
          }
        }
      },
      "fleet-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://fleet-api"
          }
        }
      },
      "reviews-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://reviews-webapi"
          }
        }
      }
    }
  }
}

